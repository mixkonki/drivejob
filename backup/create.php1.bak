<script>
    function updateMachineryOptions() {
        const operatorType = document.getElementById('operator_type').value;
        const operatorMachinery = document.getElementById('operator-machinery');
        const assistantMachinery = document.getElementById('assistant-machinery');
        const noOperatorTypeSelected = document.getElementById('no-operator-type-selected');

        // Απόκρυψη όλων των επιλογών
        operatorMachinery.style.display = 'none';
        assistantMachinery.style.display = 'none';
        noOperatorTypeSelected.style.display = 'none';

        // Εμφάνιση των κατάλληλων επιλογών με βάση τον τύπο χειριστή
        if (operatorType === 'operator') {
            operatorMachinery.style.display = 'block';
        } else if (operatorType === 'assistant') {
            assistantMachinery.style.display = 'block';
        } else {
            noOperatorTypeSelected.style.display = 'block';
        }
    }

    // Αρχικοποίηση των επιλογών μηχανημάτων με βάση τον επιλεγμένο τύπο χειριστή
    document.addEventListener('DOMContentLoaded', function() {
        updateMachineryOptions();
    });
</script>

