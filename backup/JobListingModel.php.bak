<?php

namespace Drivejob\Models;

use Drivejob\Core\Logger;

/**
 * Μοντέλο για τη διαχείριση των αγγελιών εργασίας
 */
class JobListingModel
{
    private $pdo;

    /**
     * Κατασκευαστής του μοντέλου
     */
    public function __construct($pdo)
    {
        $this->pdo = $pdo;
    }

    /**
     * Επιστρέφει μια αγγελία με βάση το ID
     *
     * @param int $id ID της αγγελίας
     * @return array|false Τα στοιχεία της αγγελίας ή false αν δεν βρέθηκε
     */
    public function getById($id)
    {
        try {
            $query = "SELECT * FROM job_listings WHERE id = ?";
            $stmt = $this->pdo->prepare($query);
            $stmt->execute([$id]);

            return $stmt->fetch(\PDO::FETCH_ASSOC);
        } catch (\PDOException $e) {
            Logger::error('Error in getById: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Επιστρέφει τους τύπους οχημάτων μιας αγγελίας
     *
     * @param int $jobListingId ID της αγγελίας
     * @return array Οι τύποι οχημάτων
     */
    public function getVehicleTypes($jobListingId)
    {
        try {
            $query = "SELECT vehicle_type FROM job_listing_vehicle_types WHERE job_listing_id = ?";
            $stmt = $this->pdo->prepare($query);
            $stmt->execute([$jobListingId]);

            $results = $stmt->fetchAll(\PDO::FETCH_COLUMN);
            return $results ?: [];
        } catch (\PDOException $e) {
            Logger::error('Error in getVehicleTypes: ' . $e->getMessage());
            return [];
        }
    }

    /**
     * Επιστρέφει τους τύπους μηχανημάτων έργου μιας αγγελίας
     *
     * @param int $jobListingId ID της αγγελίας
     * @return array Οι τύποι μηχανημάτων έργου
     */
    public function getMachineryTypes($jobListingId)
    {
        try {
            // Ανάκτηση των τύπων μηχανημάτων από τη στήλη machinery_types
            $query = "SELECT machinery_types FROM job_listings WHERE id = ?";
            $stmt = $this->pdo->prepare($query);
            $stmt->execute([$jobListingId]);

            $result = $stmt->fetch(\PDO::FETCH_COLUMN);

            // Αν υπάρχουν τύποι μηχανημάτων, τους μετατρέπουμε σε πίνακα
            if ($result) {
                return explode(',', $result);
            }

            return [];
        } catch (\PDOException $e) {
            Logger::error('Error in getMachineryTypes: ' . $e->getMessage());
            return [];
        }
    }

    /**
     * Αυξάνει τον μετρητή προβολών μιας αγγελίας
     *
     * @param int $jobListingId ID της αγγελίας
     * @return bool Επιτυχία/αποτυχία
     */
    public function incrementViewsCount($jobListingId)
    {
        try {
            $sql = "UPDATE job_listings SET views_count = views_count + 1 WHERE id = ?";
            $stmt = $this->pdo->prepare($sql);

            return $stmt->execute([$jobListingId]);
        } catch (\PDOException $e) {
            Logger::error('Error in incrementViewsCount: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Επιστρέφει τις ενεργές αγγελίες με βάση διάφορα κριτήρια
     *
     * @param array $filters Φίλτρα αναζήτησης
     * @param int $page Αριθμός σελίδας
     * @param int $limit Αριθμός αποτελεσμάτων ανά σελίδα
     * @return array Αποτελέσματα αναζήτησης και πληροφορίες σελιδοποίησης
     */
    public function getActiveListings($filters = [], $page = 1, $limit = 10)
    {
        try {
            // Βασικό ερώτημα
            $query = "SELECT DISTINCT jl.* FROM job_listings jl";

            // Προσθήκη join για τους τύπους οχημάτων αν χρειάζεται
            if (!empty($filters['vehicle_types'])) {
                $query .= " LEFT JOIN job_listing_vehicle_types jlvt ON jl.id = jlvt.job_listing_id";
            }

            // Βασικές συνθήκες
            $whereConditions = ["jl.is_active = 1"];
            $queryParams = [];

            // Προσθήκη συνθηκών αναζήτησης
            if (!empty($filters['listing_type'])) {
                $whereConditions[] = "jl.listing_type = ?";
                $queryParams[] = $filters['listing_type'];
            }

            if (!empty($filters['job_type'])) {
                $whereConditions[] = "jl.job_type = ?";
                $queryParams[] = $filters['job_type'];
            }

            if (!empty($filters['vehicle_types'])) {
                if (is_array($filters['vehicle_types'])) {
                    $placeholders = implode(',', array_fill(0, count($filters['vehicle_types']), '?'));
                    $whereConditions[] = "jlvt.vehicle_type IN ($placeholders)";
                    foreach ($filters['vehicle_types'] as $type) {
                        $queryParams[] = $type;
                    }
                } else {
                    $whereConditions[] = "jlvt.vehicle_type = ?";
                    $queryParams[] = $filters['vehicle_types'];
                }
            }

            // Αναζήτηση με βάση την τοποθεσία
            if (!empty($filters['latitude']) && !empty($filters['longitude']) && !empty($filters['search_radius'])) {
                $lat = $filters['latitude'];
                $lng = $filters['longitude'];
                $radius = $filters['search_radius'];

                // Υπολογισμός απόστασης με τον τύπο Haversine
                $whereConditions[] = "(
                    6371 * acos(
                        cos(radians(?)) * cos(radians(jl.latitude)) * cos(radians(jl.longitude) - radians(?)) + 
                        sin(radians(?)) * sin(radians(jl.latitude))
                    ) <= ?
                )";

                $queryParams[] = $lat;
                $queryParams[] = $lng;
                $queryParams[] = $lat;
                $queryParams[] = $radius;
            }

            // Συνδυασμός των συνθηκών
            if (!empty($whereConditions)) {
                $query .= " WHERE " . implode(' AND ', $whereConditions);
            }

            // Ταξινόμηση
            $query .= " ORDER BY jl.created_at DESC";

            // Μέτρηση συνολικών αποτελεσμάτων
            $countQuery = "SELECT COUNT(DISTINCT jl.id) FROM job_listings jl";

            // Προσθήκη join για τους τύπους οχημάτων αν χρειάζεται
            if (!empty($filters['vehicle_types'])) {
                $countQuery .= " LEFT JOIN job_listing_vehicle_types jlvt ON jl.id = jlvt.job_listing_id";
            }

            // Προσθήκη των συνθηκών στο ερώτημα μέτρησης
            if (!empty($whereConditions)) {
                $countQuery .= " WHERE " . implode(' AND ', $whereConditions);
            }

            $countStmt = $this->pdo->prepare($countQuery);
            $countStmt->execute($queryParams);
            $totalResults = $countStmt->fetchColumn();

            // Προσθήκη σελιδοποίησης
            $offset = ($page - 1) * $limit;
            $query .= " LIMIT ?, ?";
            $queryParams[] = $offset;
            $queryParams[] = $limit;

            // Εκτέλεση του ερωτήματος
            $stmt = $this->pdo->prepare($query);
            $stmt->execute($queryParams);
            $results = $stmt->fetchAll(\PDO::FETCH_ASSOC);

            // Προσθήκη των τύπων οχημάτων σε κάθε αγγελία
            foreach ($results as &$listing) {
                $listing['vehicle_types'] = $this->getVehicleTypes($listing['id']);
                $listing['machinery_types'] = $this->getMachineryTypes($listing['id']);
            }

            return [
                'results' => $results,
                'pagination' => [
                    'total' => $totalResults,
                    'page' => $page,
                    'limit' => $limit,
                    'pages' => ceil($totalResults / $limit)
                ]
            ];
        } catch (\PDOException $e) {
            Logger::error('Error in getActiveListings: ' . $e->getMessage());

            return [
                'results' => [],
                'pagination' => [
                    'total' => 0,
                    'page' => $page,
                    'limit' => $limit,
                    'pages' => 0
                ]
            ];
        }
    }

    /**
     * Επιστρέφει τις αγγελίες ενός οδηγού
     *
     * @param int $driverId ID του οδηγού
     * @param bool $activeOnly Μόνο ενεργές αγγελίες
     * @param int $page Αριθμός σελίδας
     * @param int $limit Αριθμός αποτελεσμάτων ανά σελίδα
     * @return array Αποτελέσματα αναζήτησης και πληροφορίες σελιδοποίησης
     */
    public function getDriverListings($driverId, $activeOnly = true, $page = 1, $limit = 10)
    {
        try {
            // Βασικό ερώτημα
            $query = "SELECT * FROM job_listings WHERE driver_id = ?";
            $queryParams = [$driverId];

            // Προσθήκη συνθήκης για ενεργές αγγελίες
            if ($activeOnly) {
                $query .= " AND is_active = 1";
            }

            // Ταξινόμηση
            $query .= " ORDER BY created_at DESC";

            // Μέτρηση συνολικών αποτελεσμάτων
            $countQuery = "SELECT COUNT(*) FROM ($query) as count_table";
            $countStmt = $this->pdo->prepare($countQuery);
            $countStmt->execute($queryParams);
            $totalResults = $countStmt->fetchColumn();

            // Προσθήκη σελιδοποίησης
            $offset = ($page - 1) * $limit;
            $query .= " LIMIT ?, ?";
            $queryParams[] = $offset;
            $queryParams[] = $limit;

            // Εκτέλεση του ερωτήματος
            $stmt = $this->pdo->prepare($query);
            $stmt->execute($queryParams);
            $results = $stmt->fetchAll(\PDO::FETCH_ASSOC);

            // Προσθήκη των τύπων οχημάτων σε κάθε αγγελία
            foreach ($results as &$listing) {
                $listing['vehicle_types'] = $this->getVehicleTypes($listing['id']);
                $listing['machinery_types'] = $this->getMachineryTypes($listing['id']);
            }

            return [
                'results' => $results,
                'pagination' => [
                    'total' => $totalResults,
                    'page' => $page,
                    'limit' => $limit,
                    'pages' => ceil($totalResults / $limit)
                ]
            ];
        } catch (\PDOException $e) {
            Logger::error('Error in getDriverListings: ' . $e->getMessage());

            return [
                'results' => [],
                'pagination' => [
                    'total' => 0,
                    'page' => $page,
                    'limit' => $limit,
                    'pages' => 0
                ]
            ];
        }
    }

    /**
     * Επιστρέφει τις αγγελίες μιας εταιρείας
     *
     * @param int $companyId ID της εταιρείας
     * @param bool $activeOnly Μόνο ενεργές αγγελίες
     * @param int $page Αριθμός σελίδας
     * @param int $limit Αριθμός αποτελεσμάτων ανά σελίδα
     * @return array Αποτελέσματα αναζήτησης και πληροφορίες σελιδοποίησης
     */
    public function getCompanyListings($companyId, $activeOnly = true, $page = 1, $limit = 10)
    {
        try {
            // Βασικό ερώτημα
            $query = "SELECT * FROM job_listings WHERE company_id = ?";
            $queryParams = [$companyId];

            // Προσθήκη συνθήκης για ενεργές αγγελίες
            if ($activeOnly) {
                $query .= " AND is_active = 1";
            }

            // Ταξινόμηση
            $query .= " ORDER BY created_at DESC";

            // Μέτρηση συνολικών αποτελεσμάτων
            $countQuery = "SELECT COUNT(*) FROM ($query) as count_table";
            $countStmt = $this->pdo->prepare($countQuery);
            $countStmt->execute($queryParams);
            $totalResults = $countStmt->fetchColumn();

            // Προσθήκη σελιδοποίησης
            $offset = ($page - 1) * $limit;
            $query .= " LIMIT ?, ?";
            $queryParams[] = $offset;
            $queryParams[] = $limit;

            // Εκτέλεση του ερωτήματος
            $stmt = $this->pdo->prepare($query);
            $stmt->execute($queryParams);
            $results = $stmt->fetchAll(\PDO::FETCH_ASSOC);

            // Προσθήκη των τύπων οχημάτων σε κάθε αγγελία
            foreach ($results as &$listing) {
                $listing['vehicle_types'] = $this->getVehicleTypes($listing['id']);
                $listing['machinery_types'] = $this->getMachineryTypes($listing['id']);
            }

            return [
                'results' => $results,
                'pagination' => [
                    'total' => $totalResults,
                    'page' => $page,
                    'limit' => $limit,
                    'pages' => ceil($totalResults / $limit)
                ]
            ];
        } catch (\PDOException $e) {
            Logger::error('Error in getCompanyListings: ' . $e->getMessage());

            return [
                'results' => [],
                'pagination' => [
                    'total' => 0,
                    'page' => $page,
                    'limit' => $limit,
                    'pages' => 0
                ]
            ];
        }
    }

    /**
     * Δημιουργεί μια νέα αγγελία
     *
     * @param array $data Δεδομένα αγγελίας
     * @return int|false ID της νέας αγγελίας ή false σε περίπτωση αποτυχίας
     */
    public function create($data)
    {
        try {
            // Αποθήκευση των τύπων οχημάτων ξεχωριστά
            $vehicleTypes = isset($data['vehicle_types']) ? $data['vehicle_types'] : [];
            unset($data['vehicle_types']);

            // Δημιουργία του SQL ερωτήματος
            $fields = array_keys($data);
            $placeholders = array_fill(0, count($fields), '?');

            $sql = "INSERT INTO job_listings (" . implode(', ', $fields) . ") VALUES (" . implode(', ', $placeholders) . ")";
            $stmt = $this->pdo->prepare($sql);

            if ($stmt->execute(array_values($data))) {
                $jobListingId = $this->pdo->lastInsertId();

                // Προσθήκη των τύπων οχημάτων
                if (!empty($vehicleTypes)) {
                    foreach ($vehicleTypes as $type) {
                        $this->addVehicleType($jobListingId, $type);
                    }
                }

                return $jobListingId;
            }

            return false;
        } catch (\PDOException $e) {
            Logger::error('Error in create: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Ενημερώνει μια υπάρχουσα αγγελία
     *
     * @param int $id ID της αγγελίας
     * @param array $data Δεδομένα αγγελίας
     * @return bool Επιτυχία/αποτυχία
     */
    public function update($id, $data)
    {
        try {
            // Δημιουργία του SQL ερωτήματος
            $fields = [];
            $values = [];

            foreach ($data as $field => $value) {
                if ($field !== 'id') {
                    $fields[] = "$field = ?";
                    $values[] = $value;
                }
            }

            $values[] = $id;

            $sql = "UPDATE job_listings SET " . implode(', ', $fields) . " WHERE id = ?";
            $stmt = $this->pdo->prepare($sql);

            return $stmt->execute($values);
        } catch (\PDOException $e) {
            Logger::error('Error in update: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Διαγράφει μια αγγελία
     *
     * @param int $id ID της αγγελίας
     * @return bool Επιτυχία/αποτυχία
     */
    public function delete($id)
    {
        try {
            // Διαγραφή των τύπων οχημάτων
            $this->deleteVehicleTypes($id);

            // Διαγραφή της αγγελίας
            $sql = "DELETE FROM job_listings WHERE id = ?";
            $stmt = $this->pdo->prepare($sql);

            return $stmt->execute([$id]);
        } catch (\PDOException $e) {
            Logger::error('Error in delete: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Προσθέτει έναν τύπο οχήματος σε μια αγγελία
     *
     * @param int $jobListingId ID της αγγελίας
     * @param string $vehicleType Τύπος οχήματος
     * @return bool Επιτυχία/αποτυχία
     */
    public function addVehicleType($jobListingId, $vehicleType)
    {
        try {
            $sql = "INSERT INTO job_listing_vehicle_types (job_listing_id, vehicle_type) VALUES (?, ?)";
            $stmt = $this->pdo->prepare($sql);

            return $stmt->execute([$jobListingId, $vehicleType]);
        } catch (\PDOException $e) {
            Logger::error('Error in addVehicleType: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Διαγράφει όλους τους τύπους οχημάτων μιας αγγελίας
     *
     * @param int $jobListingId ID της αγγελίας
     * @return bool Επιτυχία/αποτυχία
     */
    public function deleteVehicleTypes($jobListingId)
    {
        try {
            $sql = "DELETE FROM job_listing_vehicle_types WHERE job_listing_id = ?";
            $stmt = $this->pdo->prepare($sql);

            return $stmt->execute([$jobListingId]);
        } catch (\PDOException $e) {
            Logger::error('Error in deleteVehicleTypes: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Ενημερώνει τους τύπους οχημάτων μιας αγγελίας
     *
     * @param int $jobListingId ID της αγγελίας
     * @param array $vehicleTypes Τύποι οχημάτων
     * @return bool Επιτυχία/αποτυχία
     */
    public function updateVehicleTypes($jobListingId, $vehicleTypes)
    {
        try {
            // Διαγραφή των υπαρχόντων τύπων οχημάτων
            $this->deleteVehicleTypes($jobListingId);

            // Προσθήκη των νέων τύπων οχημάτων
            if (!empty($vehicleTypes)) {
                foreach ($vehicleTypes as $type) {
                    $this->addVehicleType($jobListingId, $type);
                }
            }

            return true;
        } catch (\PDOException $e) {
            Logger::error('Error in updateVehicleTypes: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Ενημερώνει τους τύπους μηχανημάτων έργου μιας αγγελίας
     *
     * @param int $jobListingId ID της αγγελίας
     * @param array $machineryTypes Τύποι μηχανημάτων έργου
     * @return bool Επιτυχία/αποτυχία
     */
    public function updateMachineryTypes($jobListingId, $machineryTypes)
    {
        try {
            // Μετατροπή του πίνακα σε string με διαχωριστικό το κόμμα
            $machineryTypesString = !empty($machineryTypes) ? implode(',', $machineryTypes) : '';

            // Ενημέρωση της στήλης machinery_types
            $sql = "UPDATE job_listings SET machinery_types = ? WHERE id = ?";
            $stmt = $this->pdo->prepare($sql);

            return $stmt->execute([$machineryTypesString, $jobListingId]);
        } catch (\PDOException $e) {
            Logger::error('Error in updateMachineryTypes: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Προσθέτει ένα tag σε μια αγγελία
     *
     * @param int $jobListingId ID της αγγελίας
     * @param int $tagId ID του tag
     * @return bool Επιτυχία/αποτυχία
     */
    public function addTag($jobListingId, $tagId)
    {
        try {
            $sql = "INSERT INTO job_listing_tags (job_listing_id, tag_id) VALUES (?, ?)";
            $stmt = $this->pdo->prepare($sql);

            return $stmt->execute([$jobListingId, $tagId]);
        } catch (\PDOException $e) {
            Logger::error('Error in addTag: ' . $e->getMessage());
            return false;
        }
    }

    /**
     * Επιστρέφει τα tags μιας αγγελίας
     *
     * @param int $jobListingId ID της αγγελίας
     * @return array Τα tags
     */
    public function getTagsByJobId($jobListingId)
    {
        try {
            $query = "SELECT t.* FROM job_listing_tags jlt
                      JOIN job_tags t ON jlt.tag_id = t.id
                      WHERE jlt.job_listing_id = ?";
            $stmt = $this->pdo->prepare($query);
            $stmt->execute([$jobListingId]);

            return $stmt->fetchAll(\PDO::FETCH_ASSOC);
        } catch (\PDOException $e) {
            Logger::error('Error in getTagsByJobId: ' . $e->getMessage());
            return [];
        }
    }
}
