    {
      "name": "Admin Get Users (OK with Admin token)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
        ],
        "url": "{{base_url}}/api/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": [ "pm.test(\"Admin can access users\", () => pm.response.to.have.status(200));" ] }
        }
      ]
    },
