# Prevent script execution in certificates directory
# Security: Block all PHP and executable files

<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow only specific file types (images and PDFs)
<FilesMatch "\.(jpg|jpeg|png|gif|pdf)$">
    Order Deny,Allow
    Allow from all
</FilesMatch>

# Disable directory browsing
Options -Indexes

# Disable script execution
php_flag engine off

# Additional security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
</IfModule>
