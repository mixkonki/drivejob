Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Προώθηση Authorization header σε FastCGI/PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # Μην επανεγγράψεις αρχεία και φακέλους που υπάρχουν
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Επανέγγραψε όλα τα άλλα στο index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Fallback για setups χωρίς mod_rewrite:
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "^(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# ═══════════════════════════════════════════════════════════════════════
#  ΚΑΝΕΝΑ Content-Security-Policy ΑΠΟ ΕΔΩ — Η ΜΟΝΗ ΠΗΓΗ ΕΙΝΑΙ ΤΟ PHP
# ═══════════════════════════════════════════════════════════════════════
#
# Εδώ υπήρχε ένα δεύτερο, αυστηρότερο CSP. Όταν φτάνουν ΔΥΟ κεφαλίδες
# CSP, ο browser δεν κρατά τη μία — επιβάλλει ΚΑΙ τις δύο, δηλαδή την
# τομή τους. Αποτέλεσμα:
#
#   - style-src χωρίς cdnjs  → το font-awesome κοβόταν (τα εικονίδια
#     εξαφανίζονταν, με σφάλμα CSP στο console)
#   - χωρίς worker-src       → έπεφτε στο default-src 'self', οπότε ο
#     blob: worker του Tesseract μπλοκαριζόταν — το OCR δεν μπορούσε να
#     ξεκινήσει ΠΟΤΕ, ό,τι κι αν έλεγε το CSP του PHP
#   - script-src με 'unsafe-eval' → ΧΑΛΑΡΩΤΕΡΟ από του PHP σε αυτό το
#     σημείο, χωρίς λόγο
#
# Το CSP ορίζεται ΜΟΝΟ στο src/Views/partials/header.php, σε ένα σημείο.
# Μην ξαναπροσθέσεις CSP εδώ — ό,τι αλλαγή χρειάζεται, γίνεται εκεί.


# ═══════════════════════════════════════════════════════════════════════
#  ΠΟΛΙΤΙΚΗ CACHE — Η ΜΟΝΙΜΗ ΛΥΣΗ
# ═══════════════════════════════════════════════════════════════════════
#
# ΤΙ ΠΗΓΕ ΣΤΡΑΒΑ: το site μπήκε σε Maintenance Mode. Το edge cache του
# παρόχου αποθήκευσε τη σελίδα «This Site is Under Maintenance» ΣΤΗ ΘΕΣΗ
# αρχείων CSS. Μετά την επαναφορά, το /css/drivers-registration.css
# εξακολουθούσε να επιστρέφει HTML — status 200, content-type text/html.
# Η φόρμα εγγραφής φόρτωνε γυμνή και δεν υπήρχε τρόπος να το καταλάβει
# κανείς: το αρχείο ήταν σωστό στον server.
#
# ΓΙΑΤΙ ΣΥΝΕΒΗ: δεν στέλναμε ΚΑΝΕΝΑ Cache-Control. Όταν ο server δεν λέει
# τι να κρατηθεί και για πόσο, ο πάροχος αποφασίζει μόνος του — και ό,τι
# μαντέψει, το κρατάει όσο θέλει.
#
# Η ΛΥΣΗ ΕΧΕΙ ΤΡΙΑ ΣΚΕΛΗ, ΚΑΙ ΤΑ ΤΡΙΑ ΧΡΕΙΑΖΟΝΤΑΙ:
#   1) Asset::url() → κάθε αρχείο φέρει ?v=<mtime>. Αλλάζει το αρχείο,
#      αλλάζει το URL. Κανένα cache δεν μπορεί να δώσει παλιό περιεχόμενο.
#   2) sw.js → network-first για σελίδες (ο browser του χρήστη).
#   3) ΑΥΤΟ ΕΔΩ → ρητές οδηγίες προς τον πάροχο (το edge cache).
#
# ⚠️ ΤΟ ΜΑΘΗΜΑ ΠΟΥ ΚΟΣΤΙΣΕ ΤΟΝ ΠΕΡΙΣΣΟΤΕΡΟ ΧΡΟΝΟ:
#
# Μετά το πρώτο deploy αυτών των κανόνων, το /sw.js εξακολουθούσε να
# βγαίνει ΧΩΡΙΣ Cache-Control ενώ το /manifest.json — στο ΙΔΙΟ μπλοκ —
# έβγαινε σωστά. Υποθέσαμε ότι φταίει η σύνταξη `expr=` του Apache.
#
# Ήταν λάθος υπόθεση. Η απόδειξη ήταν μία εντολή:
#
#     curl -I https://drivejob.gr/sw.js              → καμία κεφαλίδα, κανένα ETag
#     curl -I https://drivejob.gr/sw.js?cachebust=1  → σωστές κεφαλίδες + ETag
#
# Το ίδιο αρχείο, δύο απαντήσεις. Η πρώτη ερχόταν από το edge cache
# του παρόχου — αποθηκευμένη ΠΡΙΝ υπάρξουν αυτοί οι κανόνες. Το
# manifest.json φαινόταν διορθωμένο μόνο επειδή πριν ήταν 403: η
# αλλαγή κατάστασης το ανάγκασε να ξαναφορτωθεί.
#
# ΤΟ ΣΥΜΠΕΡΑΣΜΑ: το πρόβλημα cache κρύβει τη ΔΙΚΗ ΤΟΥ διόρθωση. Μετά
# από κάθε αλλαγή εδώ, χρειάζεται Purge από το StackCP — αλλιώς
# ελέγχεις την παλιά απόκριση και βγάζεις λάθος συμπεράσματα.
# Ο έλεγχος «με και χωρίς ?query» ξεχωρίζει τα δύο σε δύο δευτερόλεπτα
# και τον κάνει πλέον αυτόματα το scripts/check-cache.sh.
#
# (Η απλοποίηση των κανόνων παρακάτω παραμένει σωστή για άλλον λόγο:
#  το `immutable` δεν προσφέρει τίποτα όταν κάθε URL φέρει ήδη ?v=.)
#
<IfModule mod_headers.c>

    # ── Σελίδες: ΠΟΤΕ σε cache ──────────────────────────────────────
    # Μια σελίδα σε cache μπορεί να είναι σελίδα συντήρησης, σελίδα
    # άλλου χρήστη, ή περιεχόμενο πίσω από σύνδεση. Καμία δεν αξίζει
    # τον κίνδυνο. (Οι διαδρομές χωρίς κατάληξη καλύπτονται από την
    # PHP στο public/index.php — εδώ πιάνουμε τα άμεσα .php.)
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
    </FilesMatch>

    # ── Στατικά: μία εβδομάδα, με υποχρεωτική επαλήθευση ────────────
    # Δεν χρειάζεται `immutable`: κάθε αρχείο έρχεται με ?v=<mtime>,
    # οπότε μια αλλαγή παράγει ΝΕΟ URL που κανένα cache δεν έχει δει.
    # Το must-revalidate καλύπτει τους παλιούς συνδέσμους χωρίς ?v=.
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$">
        Header always set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>

    # ── Service worker & manifest: ΠΑΝΤΑ φρέσκα ─────────────────────
    # ΠΡΟΣΟΧΗ ΣΤΗ ΣΕΙΡΑ: αυτό το μπλοκ πρέπει να μένει ΜΕΤΑ το
    # προηγούμενο. Το sw.js έχει κατάληξη .js, οπότε το πιάνει και ο
    # γενικός κανόνας — και στο mod_headers νικά ο ΤΕΛΕΥΤΑΙΟΣ που
    # γράφει την κεφαλίδα. Αν το ανεβάσεις πιο πάνω, ο service worker
    # θα κλειδωθεί σε cache για μια εβδομάδα σε κάθε browser.
    <FilesMatch "^(sw\.js|manifest\.json)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# ── Μη συμπιέζεις ό,τι είναι ήδη συμπιεσμένο, συμπίεσε τα υπόλοιπα ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
