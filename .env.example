OPENAI_API_KEY=sk-...

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="DriveJob Ειδοποιήσεις"
EMAIL_DEBUG=false
