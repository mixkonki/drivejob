# DriveJob — Παράδειγμα ρυθμίσεων. Αντέγραψέ το σε .env και συμπλήρωσε τιμές.
# ΤΟ .env ΔΕΝ ΜΠΑΙΝΕΙ ΠΟΤΕ ΣΤΟ GIT.
APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_DATABASE=drivejob
