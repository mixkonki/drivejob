# DriveJob — Παράδειγμα ρυθμίσεων.
# Αντέγραψέ το σε .env και συμπλήρωσε. ΤΟ .env ΔΕΝ ΜΠΑΙΝΕΙ ΠΟΤΕ ΣΤΟ GIT.

# ─── Εφαρμογή ───────────────────────────────────────────────
# APP_ENV=production κρύβει τα σφάλματα και ενεργοποιεί ασφαλή cookies.
# Χωρίς τιμή, ο κώδικας υποθέτει production (ασφαλής προεπιλογή).
APP_ENV=local
APP_DEBUG=true
# Απαραίτητο σε παραγωγή & για cron/emails (αλλιώς λάθος links στα emails):
# APP_URL=https://drivejob.gr

# ─── Βάση δεδομένων ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drivejob
DB_USERNAME=root
DB_PASSWORD=

# ─── Τεχνητή νοημοσύνη ──────────────────────────────────────
ANTHROPIC_API_KEY=
# Προαιρετικό (εναλλακτικός provider — ai_provider στον πίνακα ai_configuration)
OPENAI_API_KEY=

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@drivejob.gr
SMTP_FROM_NAME="DriveJob"
EMAIL_DEBUG=false

# ─── SMS (όταν επιλεγεί πάροχος) ────────────────────────────
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=DriveJob

# ─── Αντίγραφα ασφαλείας ────────────────────────────────────
BACKUP_RETENTION_DAYS=14
