# PHPStan — DriveJob (Πακέτο 6)
# Level 0 = enforcing στο CI: πιάνει ανύπαρκτες κλάσεις/μεθόδους/μεταβλητές,
# δηλαδή ακριβώς την κατηγορία σφαλμάτων (schema/API drift) που μας πονούσε.
# Επόμενα επίπεδα: αύξηση σταδιακά όταν καθαρίσουν τα ~1.500 ευρήματα του level 1.
parameters:
    level: 0
    paths:
        - src
