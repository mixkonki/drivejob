@"
# IDE και editor αρχεία
.vscode/
.idea/
*.sublime-*

# Εξαρτήσεις και vendor αρχεία
/vendor/
/node_modules/
composer.phar

# Αρχεία ρυθμίσεων που περιέχουν ευαίσθητα δεδομένα
.env
config.php

# Προσωρινά αρχεία
*.log
*.cache
tmp/
temp/

# Αρχεία συστήματος
.DS_Store
Thumbs.db

# Βάση δεδομένων
*.sql
*.sqlite
"@ | Out-File -FilePath ".gitignore" -Encoding utf8