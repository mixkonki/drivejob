@"
# IDE και editor αρχεία
.vscode/
.idea/
*.sublime-*

# Εξαρτήσεις και vendor αρχεία
/vendor/
/node_modules/
composer.phar

# Αρχεία ρυθμίσεων που περιέχουν ευαίσθητα δεδομένα
.env
.env.testing.local
config.php

# Προσωρινά αρχεία
*.log
*.cache
tmp/
temp/

# Αρχεία συστήματος
.DS_Store
Thumbs.db

# Βάση δεδομένων
*.sql
*.sqlite
"@ | Out-File -FilePath ".gitignore" -Encoding utf8
# Refactoring scripts
/verify-refactoring.php
/refactoring-phase*.php
/migrate-*.php

# Test αρχεία και directories
/tests/temp/
/tests/logs/
/coverage/
phpunit.cache
.phpunit.result.cache
