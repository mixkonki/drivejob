# IDE και editor αρχεία
.vscode/
.idea/
*.sublime-*

# Εξαρτήσεις και vendor αρχεία
/vendor/
/node_modules/
composer.phar

# Αρχεία ρυθμίσεων που περιέχουν ευαίσθητα δεδομένα
# ΠΡΟΣΟΧΗ: η κάθετος στην αρχή περιορίζει το μοτίβο στη ρίζα του έργου.
# Χωρίς αυτήν, το «config.php» έκρυβε και το config/config.php από το git,
# με αποτέλεσμα η εφαρμογή να μην ξεκινά μετά από clone (Πακέτο 9).
.env
.env.testing.local
/config.php

# Ρυθμίσεις PHP του host (τις γράφει το panel, δεν ανήκουν στο έργο)
/public/.user.ini

# Προσωρινά αρχεία
*.log
*.cache
tmp/
temp/
/logs/
/storage/logs/
/storage/cache/

# Αρχεία συστήματος
.DS_Store
Thumbs.db

# Βάση δεδομένων
*.sql
*.sqlite

# Refactoring scripts
/verify-refactoring.php
/refactoring-phase*.php
/migrate-*.php

# Test αρχεία και directories
/tests/temp/
/tests/logs/
/coverage/
phpunit.cache
.phpunit.result.cache

# Προσωρινός κάδος (τα σβήνει ο χρήστης χειροκίνητα)
/_to_delete/

# Backup φάκελοι & mount artifacts
/_backup/
.fuse_hidden*

# Αρχεία χρηστών — ΠΟΤΕ στο git
/storage/uploads/
public/img/Screenshot*
