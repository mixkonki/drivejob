<script>
    function updateVehicleOptions() {
        const transportType = document.getElementById('transport_type').value;
        const passengerVehicles = document.getElementById('passenger-vehicles');
        const cargoVehicles = document.getElementById('cargo-vehicles');
        const machineryVehicles = document.getElementById('machinery-vehicles');
        const noTransportTypeSelected = document.getElementById('no-transport-type-selected');

        // Απόκρυψη όλων των επιλογών
        passengerVehicles.style.display = 'none';
        cargoVehicles.style.display = 'none';
        machineryVehicles.style.display = 'none';
        noTransportTypeSelected.style.display = 'none';

        // Εμφάνιση των κατάλληλων επιλογών με βάση τον τύπο μεταφορών
        if (transportType === 'passenger') {
            passengerVehicles.style.display = 'block';
        } else if (transportType === 'cargo') {
            cargoVehicles.style.display = 'block';
        } else if (transportType === 'machinery') {
            machineryVehicles.style.display = 'block';
        } else {
            noTransportTypeSelected.style.display = 'block';
        }
    }

    // Αρχικοποίηση των επιλογών οχημάτων με βάση τον επιλεγμένο τύπο μεταφορών
    document.addEventListener('DOMContentLoaded', function() {
        updateVehicleOptions();
    });
</script>

