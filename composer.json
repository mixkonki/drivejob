{
  "name": "drivejob/drivejob",
  "description": "Platform for managing drivers and companies.",
  "type": "project",
  "require": {
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.9",
    "symfony/var-dumper": "^6.4",
    "monolog/monolog": "^3.8",
    "setasign/fpdf": "^1.8",
    "tecnickcom/tcpdf": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "*",
    "friendsofphp/php-cs-fixer": "*",
    "mockery/mockery": "^1.6",
    "codeception/codeception": "^5.2"
  },
  "autoload": {
    "psr-4": {
      "Drivejob\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Κώστας",
      "email": "kostas.michailidis@hotmail.gr"
    }
  ],
  "license": "MIT",
  "scripts": {
    "phpstan": "phpstan analyse src --level=5 --memory-limit=512M",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpcpd": "phpcpd src",
    "psalm": "psalm --ignore-platform-reqs",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
      "test:integration": "phpunit --testsuite Integration",
    "test:functional": "codecept run functional",
    "check-all": [
      "@phpstan",
      "@phpcs",
      "@phpcpd",
      "@test"
    ]
  }
  
}
