# DriveJob Testing Environment Configuration
# Αυτό το αρχείο χρησιμοποιείται για το testing environment
# ΜΗΝ commit αυτό το αρχείο με πραγματικά credentials

# Test Database Configuration
# WHY: Ξεχωριστή database για tests για να αποφύγουμε data corruption
DB_TEST_HOST=localhost
DB_TEST_NAME=drivejob_test
DB_TEST_USER=test_user
DB_TEST_PASS=test_password
DB_TEST_PORT=3306

# Test Database DSN
# WHY: Complete connection string για PDO
DB_TEST_DSN=mysql:host=${DB_TEST_HOST};dbname=${DB_TEST_NAME};port=${DB_TEST_PORT};charset=utf8mb4

# Test Environment Settings
# WHY: Διαφορετικές ρυθμίσεις για testing environment
APP_ENV=testing
APP_DEBUG=true
APP_LOG_LEVEL=debug

# Test Email Configuration (για notification tests)
# WHY: Fake email service για testing χωρίς actual email sending
MAIL_TEST_DRIVER=log
MAIL_TEST_FROM=test@drivejob.local
MAIL_TEST_NAME="DriveJob Test"

# Test Cache Configuration
# WHY: In-memory cache για tests
CACHE_TEST_DRIVER=array
CACHE_TEST_TTL=3600

# Test Session Configuration
# WHY: Array driver για session tests
SESSION_TEST_DRIVER=array
SESSION_TEST_LIFETIME=120

# Test Rate Limiting
# WHY: Relaxed rate limits για testing
RATE_LIMIT_TEST_ENABLED=false
RATE_LIMIT_TEST_MAX_ATTEMPTS=1000

# Test OpenAI Configuration (για AI matching tests)
# WHY: Mock OpenAI service για testing
OPENAI_TEST_API_KEY=test_key_placeholder
OPENAI_TEST_MODEL=gpt-3.5-turbo
OPENAI_TEST_MOCK_ENABLED=true

# Test File Upload Configuration
# WHY: Temporary directory για test file uploads
UPLOAD_TEST_PATH=tests/temp/uploads
UPLOAD_TEST_MAX_SIZE=10485760

# Test Logging Configuration
# WHY: Separate log files για tests
LOG_TEST_CHANNEL=testing
LOG_TEST_PATH=tests/logs/test.log
LOG_TEST_LEVEL=debug

# Security Settings για Testing
# WHY: Relaxed security για testing environment
JWT_TEST_SECRET=test_jwt_secret_key_placeholder
ENCRYPTION_TEST_KEY=test_encryption_key_placeholder
CSRF_TEST_ENABLED=false

# External Service Mocking
# WHY: Mock external services για isolated testing
GOOGLE_MAPS_TEST_API_KEY=test_google_maps_key
GOOGLE_MAPS_TEST_MOCK_ENABLED=true

SMS_TEST_PROVIDER=mock
SMS_TEST_API_KEY=test_sms_key

# Test Data Seeding
# WHY: Consistent test data για reproducible tests
TEST_SEED_ENABLED=true
TEST_SEED_DRIVERS_COUNT=10
TEST_SEED_COMPANIES_COUNT=5
TEST_SEED_JOBS_COUNT=20

# Performance Testing Settings
# WHY: Configuration για performance tests
PERF_TEST_ENABLED=false
PERF_TEST_MAX_EXECUTION_TIME=30
PERF_TEST_MEMORY_LIMIT=256M

# Database Connection Pool για Tests
# WHY: Optimized connections για test performance
DB_TEST_POOL_MIN=1
DB_TEST_POOL_MAX=5
DB_TEST_POOL_TIMEOUT=30

# Test Cleanup Settings
# WHY: Automatic cleanup μετά τα tests
TEST_CLEANUP_ENABLED=true
TEST_CLEANUP_TABLES=drivers,companies,users,job_listings,matching_scores
TEST_CLEANUP_PRESERVE_SCHEMA=true
