# Deny all web access to devtools directory
# Security: Prevent any HTTP access to development scripts

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Additional security measures
<FilesMatch ".*">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Disable directory browsing
Options -Indexes

# Disable script execution
php_flag engine off

# Block access to all file types
<Files *>
    Order Allow,Deny
    Deny from all
</Files>

# Security headers (if accessed somehow)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
